road(a, b, 5).
road(a, c, 10).
road(b, c, 3).
road(b, d, 8).
road(c, d, 2).

route(X, Y, [X,Y], D) :-
    road(X, Y, D).

route(X, Y, [X|Path], D) :-
    road(X, Z, D1),
    X \= Y,
    route(Z, Y, Path, D2),
    D is D1 + D2.

shortest(X, Y, Path, D) :-
    setof(Cost-P, route(X,Y,P,Cost), [D-Path|_]).
