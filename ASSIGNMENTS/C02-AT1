### Question 1: Greedy Best-First Search

h = {'Gate': 400, 'Library': 330, 'Canteen': 240,
     'Hostel': 160, 'Admin': 110, 'Auditorium': 0}

graph = {
    'Gate': [('Library', 120), ('Canteen', 200)],
    'Canteen': [('Hostel', 100), ('Admin', 260)],
    'Admin': [('Auditorium', 120)],
    'Hostel': [('Auditorium', 180)],
    'Library': [('Lab', 150), ('Hostel', 300)],
    'Lab': [('Auditorium', 350)],
    'Auditorium': []
}

node, distance = 'Gate', 0
path = [node]
visited = set()

while node != 'Auditorium':
    visited.add(node)
    candidates = [(h[n], n, d) for n, d in graph[node]
                  if n not in visited]
    _, nxt, cost = min(candidates)
    distance += cost
    node = nxt
    path.append(node)

print("Route:", " -> ".join(path))
print("Total Distance:", distance, "m")

### Question 2: A* Search

import heapq

h = {'Gate': 400, 'Library': 330, 'Canteen': 240,
     'Lab': 280, 'Hostel': 160, 'Admin': 110,
     'Auditorium': 0}

graph = {
    'Gate': [('Library', 120), ('Canteen', 200)],
    'Library': [('Lab', 150), ('Hostel', 300)],
    'Canteen': [('Hostel', 100), ('Admin', 260)],
    'Lab': [('Auditorium', 350)],
    'Hostel': [('Auditorium', 180)],
    'Admin': [('Auditorium', 120)],
    'Auditorium': []
}

pq = [(h['Gate'], 0, 'Gate', ['Gate'])]
best = {'Gate': 0}

while pq:
    f, g, node, path = heapq.heappop(pq)

    if g != best[node]:
        continue

    if node == 'Auditorium':
        print("Route:", " -> ".join(path))
        print("Total Distance:", g, "m")
        break

    for nxt, cost in graph[node]:
        ng = g + cost
        if ng < best.get(nxt, float('inf')):
            best[nxt] = ng
            heapq.heappush(
                pq, (ng + h[nxt], ng, nxt, path + [nxt])
            )


