### Question 5: Alpha-Beta Pruning

moves = {
    'M1': [6, 9, 7],
    'M2': [4, 8, 10],
    'M3': [7, 5, 12]
}

alpha = float('-inf')
evaluated = 0

for move, scores in moves.items():
    beta = float('inf')

    for i, score in enumerate(scores):
        evaluated += 1
        beta = min(beta, score)

        if beta <= alpha:
            print(move, "Pruned:", scores[i+1:])
            break

    print(move, "Value:", beta)
    alpha = max(alpha, beta)

print("Best Value:", alpha)
print("Positions Evaluated:", evaluated)
print("Positions Pruned:", 9 - evaluated)
