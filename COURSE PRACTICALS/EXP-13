def minimax(board, is_max):
    if "X" in board and board.count("XXX") > 0:
        return 1
    if "O" in board and board.count("OOO") > 0:
        return -1
    if " " not in board:
        return 0

    if is_max:
        best = -100
        for i in range(9):
            if board[i] == " ":
                board[i] = "X"
                best = max(best, minimax(board, False))
                board[i] = " "
        return best
    else:
        best = 100
        for i in range(9):
            if board[i] == " ":
                board[i] = "O"
                best = min(best, minimax(board, True))
                board[i] = " "
        return best

board = [" "] * 9
best_score = -100
best_move = -1

for i in range(9):
    board[i] = "X"
    score = minimax(board, False)
    board[i] = " "

    if score > best_score:
        best_score = score
        best_move = i

print("Best move for X is position:", best_move + 1)
