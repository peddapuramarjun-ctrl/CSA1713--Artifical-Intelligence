% Father and Mother Rules
father(X, Y) :-
    male(X),
    parent(X, Y).

mother(X, Y) :-
    female(X),
    parent(X, Y).

% Grandparent Rule
grandparent(X, Y) :-
    parent(X, Z),
    parent(Z, Y).

% Sibling Rule
sibling(X, Y) :-
    parent(Z, X),
    parent(Z, Y),
    X \= Y.

