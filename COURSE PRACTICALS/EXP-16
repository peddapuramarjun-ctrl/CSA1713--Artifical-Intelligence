
import numpy as np
from sklearn.neural_network import MLPClassifier

# Input data
X = np.array([
    [0, 0],
    [0, 1],
    [1, 0],
    [1, 1]
])

# Target output (XOR)
y = np.array([0, 1, 1, 0])

# Create Feed Forward Neural Network
model = MLPClassifier(
    hidden_layer_sizes=(4,),
    activation='relu',
    solver='lbfgs',
    max_iter=1000,
    random_state=1
)

# Train the neural network
model.fit(X, y)

# Predict output
predictions = model.predict(X)

# Display results
print("Input Data:")
print(X)

print("\nActual Output:")
print(y)

print("\nPredicted Output:")
print(predictions)
