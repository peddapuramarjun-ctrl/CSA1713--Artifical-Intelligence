
import random
random.seed(7)
POP=8
def fitness(x): return x*x
pop=[random.randrange(32) for _ in range(POP)]
for _ in range(20):
    pop.sort(key=fitness,reverse=True); elites=pop[:2]; nxt=elites[:]
    while len(nxt)<POP:
        a,b=random.choices(pop[:4],k=2); cut=random.randrange(1,5); child=((a>>cut)<<cut)|(b&((1<<cut)-1))
        if random.random()<.1: child^=1<<random.randrange(5)
        nxt.append(child)
    pop=nxt
best=max(pop,key=fitness); print('Best x:',best); print('Maximum f(x):',fitness(best))
