
% Planets Database

planet(mercury, 1).
planet(venus, 2).
planet(earth, 3).
planet(mars, 4).
planet(jupiter, 5).
planet(saturn, 6).
planet(uranus, 7).
planet(neptune, 8).

% Rule to find planet position
planet_position(Name, Position) :-
    planet(Name, Position).

% Rule to check whether a planet exists
is_planet(Name) :-
    planet(Name, _).

